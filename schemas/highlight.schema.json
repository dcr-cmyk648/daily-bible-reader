{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daily-bible-reader.local/schemas/highlight.schema.json",
  "title": "Append-only shared verse-highlight event",
  "type": "object",
  "required": [
    "eventId",
    "highlightId",
    "clientRequestId",
    "planVersion",
    "readingId",
    "eventType",
    "bookId",
    "chapter",
    "verse",
    "authorId",
    "displayName",
    "baseRevision",
    "revision",
    "createdAt",
    "updatedAt",
    "deletedAt"
  ],
  "properties": {
    "eventId": {"type": "string", "minLength": 16, "maxLength": 100},
    "highlightId": {"type": "string", "minLength": 16, "maxLength": 100},
    "clientRequestId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{15,99}$"},
    "planVersion": {"type": "string", "minLength": 1, "maxLength": 80},
    "readingId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{1,79}$"},
    "eventType": {"enum": ["create", "delete"]},
    "bookId": {"type": "string", "pattern": "^[A-Z0-9]{2,8}$"},
    "chapter": {"type": "integer", "minimum": 1, "maximum": 200},
    "verse": {"type": "integer", "minimum": 1, "maximum": 500},
    "authorId": {"type": "string", "minLength": 1, "maxLength": 80},
    "displayName": {"type": "string", "minLength": 1, "maxLength": 80},
    "baseRevision": {"type": "integer", "minimum": 0},
    "revision": {"type": "integer", "minimum": 1},
    "createdAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"},
    "deletedAt": {"type": ["string", "null"], "format": "date-time"}
  },
  "additionalProperties": false
}
