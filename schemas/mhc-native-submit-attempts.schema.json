{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daily-bible-reader.local/schemas/mhc-native-submit-attempts.schema.json",
  "title": "Private native Matthew Henry failed-submit attempt accounting",
  "type": "object",
  "required": ["schema_version", "work_item_id", "work_item_sha256", "plan_version", "lease_id", "ledger_lease_event_id", "attempts"],
  "properties": {
    "schema_version": {"const": "mhc-native-submit-attempts/v1"},
    "work_item_id": {"type": "string", "pattern": "^MHNWI-[a-f0-9]{32}$"},
    "work_item_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "plan_version": {"type": "string", "minLength": 1},
    "lease_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "ledger_lease_event_id": {"type": "string", "minLength": 8, "maxLength": 200},
    "attempts": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["ordinal", "candidate_sha256", "validation_code", "diagnostics_sha256"],
        "properties": {
          "ordinal": {"type": "integer", "minimum": 1, "maximum": 3},
          "candidate_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "validation_code": {"enum": ["NATIVE_CANDIDATE_MISSING", "NATIVE_CANDIDATE_JSON_INVALID", "NATIVE_CANDIDATE_INVALID"]},
          "diagnostics_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
