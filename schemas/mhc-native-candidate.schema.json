{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daily-bible-reader.local/schemas/mhc-native-candidate.schema.json",
  "title": "Native Matthew Henry scheduled candidate",
  "type": "object",
  "required": ["schema_version", "work_item_id", "fact_brief", "verse_drafts"],
  "properties": {
    "schema_version": {"const": "mhc-native-candidate/v1"},
    "work_item_id": {"type": "string", "pattern": "^MHNWI-[a-f0-9]{32}$"},
    "fact_brief": {
      "type": "object",
      "required": ["verse_briefs"],
      "properties": {
        "verse_briefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {"$ref": "#/$defs/verseBrief"}
        }
      },
      "additionalProperties": false
    },
    "verse_drafts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {"$ref": "#/$defs/verseDraft"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "verseBrief": {
      "type": "object",
      "required": ["verse_id", "coverage_type", "source_unit_ids", "source_reference_label", "facts"],
      "properties": {
        "verse_id": {"type": "string", "pattern": "^[A-Z0-9]{2,8}\\.[1-9][0-9]{0,2}\\.[1-9][0-9]{0,2}$"},
        "coverage_type": {"type": "string", "enum": ["direct", "range-derived", "no-distinct-comment"]},
        "source_unit_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,159}$"}
        },
        "source_reference_label": {"type": "string", "minLength": 1, "maxLength": 200},
        "facts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {"$ref": "#/$defs/fact"}
        }
      },
      "additionalProperties": false
    },
    "fact": {
      "type": "object",
      "required": ["fact_id", "importance", "category", "statement", "source_atom_id", "source_snippet_id", "evidence_quote", "must_include_terms", "qualification", "verse_relevance"],
      "properties": {
        "fact_id": {"type": "string", "pattern": "^[A-Z0-9]{2,8}\\.[1-9][0-9]{0,2}\\.[1-9][0-9]{0,2}:f[0-9]{2}$"},
        "importance": {"type": "string", "enum": ["required", "supporting"]},
        "category": {"type": "string", "enum": ["identity", "relationship", "historical_context", "action_or_event", "cause", "consequence", "image", "theological_claim", "interpretive_option", "qualification", "application"]},
        "statement": {"type": "string", "minLength": 3, "maxLength": 500},
        "source_atom_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,199}$"},
        "source_snippet_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,239}$"},
        "evidence_quote": {"type": "string", "minLength": 3, "maxLength": 500},
        "must_include_terms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {"type": "string", "minLength": 1, "maxLength": 80}
        },
        "qualification": {"type": "string", "enum": ["none", "some_understand", "alternative", "uncertain"]},
        "verse_relevance": {"type": "string", "enum": ["target_marker", "anchor_supported", "shared_range_context"]}
      },
      "additionalProperties": false
    },
    "verseDraft": {
      "type": "object",
      "required": ["verse_id", "blurb", "coverage_type", "scope_note", "source_unit_ids", "source_atom_ids", "source_reference_label"],
      "properties": {
        "verse_id": {"type": "string", "pattern": "^[A-Z0-9]{2,8}\\.[1-9][0-9]{0,2}\\.[1-9][0-9]{0,2}$"},
        "blurb": {"type": "string", "minLength": 1, "maxLength": 1200},
        "coverage_type": {"type": "string", "enum": ["direct", "range-derived", "no-distinct-comment"]},
        "scope_note": {"type": "string", "minLength": 1, "maxLength": 400},
        "source_unit_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,159}$"}
        },
        "source_atom_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,199}$"}
        },
        "source_reference_label": {"type": "string", "minLength": 1, "maxLength": 200}
      },
      "additionalProperties": false
    }
  }
}
