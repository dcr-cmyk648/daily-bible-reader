{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daily-bible-reader.local/schemas/reading.schema.json",
  "title": "Daily Bible Reader schedule entry",
  "type": "object",
  "required": [
    "planVersion",
    "dayIndex",
    "readingId",
    "kind",
    "bookId",
    "orderingRationale",
    "chronologyBasis",
    "confidence",
    "notes",
    "sourceIds"
  ],
  "properties": {
    "planVersion": {"type": "string", "minLength": 1, "maxLength": 80},
    "dayIndex": {"type": "integer", "minimum": 1},
    "readingId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{1,79}$"},
    "kind": {"enum": ["book_intro", "chapter"]},
    "bookId": {"type": "string", "pattern": "^[A-Z0-9]{2,8}$"},
    "chapter": {"type": "integer", "minimum": 1, "maximum": 200},
    "passages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["bookId", "chapter", "verseCount"],
        "properties": {
          "bookId": {"type": "string", "pattern": "^[A-Z0-9]{2,8}$"},
          "chapter": {"type": "integer", "minimum": 1, "maximum": 200},
          "verseCount": {"type": "integer", "minimum": 1, "maximum": 500}
        },
        "additionalProperties": false
      }
    },
    "sourcePlanDay": {"type": "integer", "minimum": 1, "maximum": 1000},
    "orderingRationale": {"type": "string", "minLength": 1, "maxLength": 2000},
    "chronologyBasis": {"enum": ["event", "composition", "traditional", "pragmatic"]},
    "confidence": {"enum": ["high", "medium", "low"]},
    "notes": {"type": "string", "maxLength": 4000},
    "sourceIds": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{1,99}$"},
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "chapter"}}},
      "then": {"required": ["chapter", "passages"]},
      "else": {
        "allOf": [
          {"not": {"required": ["chapter"]}},
          {"not": {"required": ["passages"]}}
        ]
      }
    }
  ],
  "additionalProperties": false
}
