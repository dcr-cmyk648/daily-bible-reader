{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daily-bible-reader.local/schemas/mhc-native-runtime-pointer.schema.json",
  "title": "Native Henry runtime pointer",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_revision", "release", "manifest_sha256", "config_sha256"],
  "properties": {
    "schema_version": {"const": "mhc-native-runtime-pointer/v1"},
    "source_revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "release": {"type": "string", "pattern": "^[a-f0-9]{40}-[a-f0-9]{16}$"},
    "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "config_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
