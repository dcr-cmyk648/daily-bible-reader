{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daily-bible-reader.local/schemas/service-supervisor-daily-state.schema.json",
  "title": "Private source-bound daily supervisor job",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "id", "readingId", "phase", "sourceRevision", "workOrder", "createdAt", "research", "draft", "approvalPath", "approvalSha256", "authorSessionId", "reviewerSessionId", "contentSha256", "metadataSha256", "registrySha256", "blocker"],
  "properties": {
    "schemaVersion": {"const": "service-supervisor-daily-state/v1"},
    "id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "readingId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{1,79}$"},
    "sourceRevision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "phase": {"enum": ["queued", "authoring", "waiting_henry", "review_pending", "editorial_attention", "approved", "publishing", "published", "blocked"]},
    "createdAt": {"type": "string", "format": "date-time"},
    "workOrder": {"$ref": "#/$defs/artifact"}, "baseRegistry": {"$ref": "#/$defs/artifact"},
    "research": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/artifact"}]},
    "draft": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/draft"}]},
    "approvalPath": {"type": ["string", "null"]}, "approvalSha256": {"$ref": "#/$defs/hash"},
    "contentSha256": {"$ref": "#/$defs/hash"}, "metadataSha256": {"$ref": "#/$defs/hash"}, "registrySha256": {"$ref": "#/$defs/hash"},
    "authorSessionId": {"$ref": "#/$defs/session"}, "reviewerSessionId": {"$ref": "#/$defs/session"},
    "authorThreadId": {"type": "string", "minLength": 1}, "researchThreadId": {"type": "string", "minLength": 1}, "reviewerThreadId": {"type": "string", "minLength": 1},
    "publicationTransactionId": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "henryApproval": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "inputSha256", "approvedSha256", "libraryReadingSha256"], "properties": {
      "path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/hash"}, "inputSha256": {"$ref": "#/$defs/hash"},
      "approvedSha256": {"$ref": "#/$defs/hash"}, "libraryReadingSha256": {"$ref": "#/$defs/hash"}
    }},
    "blocker": {"type": ["object", "null"], "required": ["code"], "additionalProperties": false, "properties": {
      "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,79}$"}, "findings": {"$ref": "#/$defs/findings"}
    }},
    "repair": {"type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "reviewExecutionId", "priorDraft", "findings", "priorMarkdown", "priorMetadataJson", "allowedRepairCount"], "properties": {
        "schemaVersion": {"const": "supervisor-editorial-repair/v1"}, "reviewExecutionId": {"$ref": "#/$defs/session"},
        "priorDraft": {"$ref": "#/$defs/draft"}, "findings": {"$ref": "#/$defs/findings"},
        "priorMarkdown": {"type": "string", "maxLength": 1048576}, "priorMetadataJson": {"type": "string", "maxLength": 1048576}, "allowedRepairCount": {"const": 1}
      }}
  },
  "$defs": {
    "hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}, "session": {"type": ["string", "null"], "pattern": "^[a-f0-9]{32}$"},
    "findings": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"type": "string", "minLength": 1, "maxLength": 3000}},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {
      "path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    }},
    "draft": {"type": "object", "additionalProperties": false, "required": ["inputRoot", "contentPath", "metadataPath", "priorRegistrySha256", "contentSha256", "metadataSha256", "registrySha256", "originalContentSha256", "originalMetadataSha256"], "properties": {
      "inputRoot": {"type": "string", "minLength": 1}, "contentPath": {"type": "string", "minLength": 1}, "metadataPath": {"type": "string", "minLength": 1},
      "priorRegistrySha256": {"$ref": "#/$defs/hash"}, "contentSha256": {"$ref": "#/$defs/hash"}, "metadataSha256": {"$ref": "#/$defs/hash"}, "registrySha256": {"$ref": "#/$defs/hash"},
      "originalContentSha256": {"$ref": "#/$defs/hash"}, "originalMetadataSha256": {"$ref": "#/$defs/hash"}
    }}
  }
}
