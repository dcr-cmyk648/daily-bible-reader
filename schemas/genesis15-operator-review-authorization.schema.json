{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daily-bible-reader.local/schemas/genesis15-operator-review-authorization.schema.json",
  "title": "One manager-authorized Genesis 15 final review",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "policyId", "decision", "issuer", "issuedAt", "supervisorSourceRevision", "supervisorManifestSha256", "supervisorConfigSha256", "nativeRuntime", "readingId", "nativeInputSha256", "nativeEventSha256", "reviewBasisSha256", "mechanicalFindingsSha256", "priorThreadEvidenceSha256", "failedReviews", "policy"],
  "properties": {
    "schemaVersion": {"const": "genesis15-operator-review-authorization/v1"},
    "policyId": {"const": "genesis15-final-review-recovery-2026-10-10"},
    "decision": {"const": "authorize_one_final_review"},
    "issuer": {"const": "BibleApp Manager"},
    "issuedAt": {"type": "string", "format": "date-time"},
    "supervisorSourceRevision": {"$ref": "#/$defs/revision"},
    "supervisorManifestSha256": {"$ref": "#/$defs/hash"},
    "supervisorConfigSha256": {"$ref": "#/$defs/hash"},
    "nativeRuntime": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceRevision", "manifestSha256", "configSha256"],
      "properties": {"sourceRevision": {"$ref": "#/$defs/revision"}, "manifestSha256": {"$ref": "#/$defs/hash"}, "configSha256": {"$ref": "#/$defs/hash"}}
    },
    "readingId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,159}$"},
    "nativeInputSha256": {"$ref": "#/$defs/hash"},
    "nativeEventSha256": {"$ref": "#/$defs/hash"},
    "reviewBasisSha256": {"$ref": "#/$defs/hash"},
    "mechanicalFindingsSha256": {"$ref": "#/$defs/hash"},
    "priorThreadEvidenceSha256": {"$ref": "#/$defs/hash"},
    "failedReviews": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {"type": "object", "additionalProperties": false, "required": ["ordinal", "executionId", "packetInputSha256", "rawOutputSha256"],
        "properties": {"ordinal": {"enum": [1,2]}, "executionId": {"type": "string", "pattern": "^[a-f0-9]{32}$"}, "packetInputSha256": {"$ref": "#/$defs/hash"}, "rawOutputSha256": {"$ref": "#/$defs/hash"}}}
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["model", "reasoningEffort", "billingRoute", "maxExecutions", "maxDurationMs", "allowProseCorrections", "allowPacketRepair", "allowResponseCorrection"],
      "properties": {"model": {"const": "gpt-6.1-sol"}, "reasoningEffort": {"const": "high"}, "billingRoute": {"const": "existing ChatGPT login only"}, "maxExecutions": {"const": 1}, "maxDurationMs": {"const": 900000}, "allowProseCorrections": {"const": true}, "allowPacketRepair": {"const": false}, "allowResponseCorrection": {"const": false}}
    }
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"}}
}
