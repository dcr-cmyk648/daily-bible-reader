{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daily-bible-reader.local/schemas/mhc-normalized-source.schema.json",
  "title": "Normalized public-domain commentary source unit",
  "type": "object",
  "required": [
    "schema_version",
    "source_id",
    "source_unit_id",
    "work_title",
    "book_id",
    "chapter",
    "verse_start",
    "verse_end",
    "reference_label",
    "unit_type",
    "source_text",
    "source_text_sha256",
    "source_atoms",
    "worker_source_sha256",
    "excluded_scripture_sha256",
    "verse_anchors",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": "mhc-normalized-source/v3"},
    "source_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,99}$"},
    "source_unit_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,159}$"},
    "work_title": {"type": "string", "minLength": 1, "maxLength": 300},
    "book_id": {"type": "string", "pattern": "^[A-Z0-9]{2,8}$"},
    "chapter": {"type": ["integer", "null"], "minimum": 1, "maximum": 200},
    "verse_start": {"type": ["integer", "null"], "minimum": 1, "maximum": 500},
    "verse_end": {"type": ["integer", "null"], "minimum": 1, "maximum": 500},
    "reference_label": {"type": "string", "minLength": 1, "maxLength": 200},
    "unit_type": {"enum": ["book_intro", "chapter_intro", "verse_range"]},
    "source_text": {"type": "string", "minLength": 1, "maxLength": 1000000},
    "source_text_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_atoms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": ["source_atom_id", "sequence", "atom_type", "text", "text_sha256"],
        "properties": {
          "source_atom_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,199}$"},
          "sequence": {"type": "integer", "minimum": 1, "maximum": 200},
          "atom_type": {"enum": ["heading", "commentary"]},
          "text": {"type": "string", "minLength": 1, "maxLength": 100000},
          "text_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "worker_source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "excluded_scripture_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "verse_anchors": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": ["verse", "anchor_terms"],
        "properties": {
          "verse": {"type": "integer", "minimum": 1, "maximum": 500},
          "anchor_terms": {
            "type": "array",
            "minItems": 1,
            "maxItems": 18,
            "items": {"type": "string", "pattern": "^[a-z]+(?:'[a-z]+)?$"},
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_url",
        "download_url",
        "module_name",
        "module_version",
        "source_version_date",
        "retrieved_at",
        "license",
        "archive_sha256",
        "source_format",
        "versification"
      ],
      "properties": {
        "source_url": {"type": "string", "format": "uri"},
        "download_url": {"type": "string", "format": "uri"},
        "module_name": {"const": "MHC"},
        "module_version": {"type": "string", "minLength": 1, "maxLength": 30},
        "source_version_date": {"type": "string", "format": "date"},
        "retrieved_at": {"type": "string", "format": "date"},
        "license": {"type": "string", "minLength": 1, "maxLength": 200},
        "archive_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "source_format": {"const": "CrossWire SWORD zCom4 OSIS"},
        "versification": {"const": "KJV"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
