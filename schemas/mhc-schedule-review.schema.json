{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daily-bible-reader.local/schemas/mhc-schedule-review.schema.json",
  "title": "Hash-bound review of one scheduled Matthew Henry reading",
  "type": "object",
  "required": [
    "schema_version",
    "reading_id",
    "plan_version",
    "prompt_version",
    "reviewed_at",
    "reviewer",
    "status",
    "scope",
    "assertions",
    "findings",
    "corrections",
    "passages"
  ],
  "properties": {
    "schema_version": {"const": "mhc-schedule-review/v1"},
    "reading_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,159}$"},
    "plan_version": {"type": "string", "minLength": 1, "maxLength": 200},
    "prompt_version": {"type": "string", "minLength": 1, "maxLength": 100},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "reviewer": {"type": "string", "minLength": 2, "maxLength": 120},
    "status": {"enum": ["in_review", "approved"]},
    "scope": {"const": "every_condensation_and_every_cited_atom"},
    "assertions": {
      "type": "object",
      "required": [
        "compared_every_condensation_with_cited_atoms",
        "citations_resolve_to_exact_stored_atoms",
        "no_idea_crossed_from_an_unrelated_range",
        "no_outside_material_or_invented_distinction",
        "no_prohibited_source_reporting_language",
        "no_extended_source_copying",
        "deterministic_validation_passed"
      ],
      "properties": {
        "compared_every_condensation_with_cited_atoms": {"const": true},
        "citations_resolve_to_exact_stored_atoms": {"const": true},
        "no_idea_crossed_from_an_unrelated_range": {"const": true},
        "no_outside_material_or_invented_distinction": {"const": true},
        "no_prohibited_source_reporting_language": {"const": true},
        "no_extended_source_copying": {"const": true},
        "deterministic_validation_passed": {"const": true}
      },
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {"type": "string", "minLength": 3, "maxLength": 1000}
    },
    "corrections": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["verse_id", "replacement_blurb", "reason"],
        "properties": {
          "verse_id": {"type": "string", "pattern": "^[A-Z0-9]{2,8}\\.[1-9][0-9]{0,2}\\.[1-9][0-9]{0,2}$"},
          "replacement_blurb": {"type": "string", "minLength": 20, "maxLength": 1000},
          "reason": {"type": "string", "minLength": 3, "maxLength": 500}
        },
        "additionalProperties": false
      }
    },
    "passages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "book_id",
          "chapter",
          "job_id",
          "fingerprint",
          "runtime_basis_sha256",
          "record_count",
          "source_atom_count"
        ],
        "properties": {
          "book_id": {"type": "string", "pattern": "^[A-Z0-9]{2,8}$"},
          "chapter": {"type": "integer", "minimum": 1, "maximum": 200},
          "job_id": {"type": "string", "minLength": 3, "maxLength": 100},
          "fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "runtime_basis_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "record_count": {"type": "integer", "minimum": 1, "maximum": 500},
          "source_atom_count": {"type": "integer", "minimum": 1, "maximum": 1000}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
