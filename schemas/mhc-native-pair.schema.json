{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daily-bible-reader.local/schemas/mhc-native-pair.schema.json",
  "title": "Private native Matthew Henry paired-slot selection",
  "type": "object",
  "required": ["schema_version", "pair_id", "pair_sha256", "plan_version", "reading_id", "schedule_date", "primary_automation_id", "primary_slot", "selected_at", "state", "source_state", "code"],
  "properties": {
    "schema_version": {"const": "mhc-native-pair/v1"},
    "pair_id": {"type": "string", "pattern": "^MHNP-[a-f0-9]{32}$"},
    "pair_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "plan_version": {"type": "string", "minLength": 1, "maxLength": 200},
    "reading_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,159}$"},
    "schedule_date": {"type": "string", "format": "date"},
    "primary_automation_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "primary_slot": {"type": "string", "format": "date-time"},
    "selected_at": {"type": "string", "format": "date-time"},
    "state": {"enum": ["selected", "ready", "blocked"]},
    "source_state": {"type": "array", "maxItems": 16, "items": {"type": "object", "required": ["chapter", "source_hash", "normalized_hash", "chunks"], "properties": {"chapter": {"type": "string", "pattern": "^[A-Z0-9]{2,8}:[1-9][0-9]{0,2}$"}, "source_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "normalized_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "chunks": {"type": "array", "minItems": 1, "maxItems": 200, "items": {"type": "object", "required": ["chunk_id", "verse_ids", "spark_work_item_id"], "properties": {"chunk_id": {"type": "string", "pattern": "^[0-9]{3}-[0-9]{3}$"}, "verse_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "spark_work_item_id": {"type": "string", "pattern": "^MHNWI-[a-f0-9]{32}$"}}, "additionalProperties": false}}}, "additionalProperties": false}},
    "code": {"type": ["string", "null"], "pattern": "^[A-Z0-9_:-]{1,120}$"}
  },
  "additionalProperties": false
}
