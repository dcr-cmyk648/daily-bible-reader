{
  "name": "daily-bible-reader",
  "version": "0.1.0",
  "private": true,
  "description": "Private two-person daily ESV reader with Drive-hosted commentary and revision-aware shared comments.",
  "scripts": {
    "build": "npm run build:hybrid && npm run build:token-canary && npm run build:pwa",
    "build:hybrid": "node scripts/build-apps-script.mjs",
    "build:token-canary": "node scripts/build-apps-script-token-canary.mjs",
    "build:pwa": "node scripts/build-pages-pwa.mjs",
    "publish:pages": "npm run publish:pages-assets && npm run publish:pwa",
    "publish:pages-assets": "node scripts/publish-pages-assets.mjs",
    "publish:pwa": "node scripts/publish-pages-pwa.mjs",
    "verify:pages": "npm run verify:pages-assets && npm run verify:pwa",
    "verify:pages-assets": "node scripts/verify-pages-assets.mjs",
    "verify:pwa": "node scripts/verify-pages-pwa.mjs",
    "dev": "node scripts/dev-server.mjs",
    "reader-codes": "node scripts/generate-reader-codes.mjs",
    "mhc:acquire": "node scripts/mhc-pipeline.mjs acquire",
    "mhc:normalize:genesis-1": "node scripts/mhc-pipeline.mjs normalize --book GEN --chapter 1",
    "mhc:preflight": "node scripts/mhc-pipeline.mjs preflight",
    "mhc:pilot:dry-run": "node scripts/mhc-pipeline.mjs pilot --book GEN --chapter 1 --dry-run",
    "mhc:pilot": "node scripts/mhc-pipeline.mjs pilot --book GEN --chapter 1",
    "mhc:pilot:spark": "node scripts/mhc-pipeline.mjs generate --book GEN --chapter 1 --model gpt-5.3-codex-spark",
    "mhc:pilot:luna": "node scripts/mhc-pipeline.mjs generate --book GEN --chapter 1 --model gpt-5.6-luna",
    "mhc:next:dry-run": "node scripts/mhc-pipeline.mjs schedule-next --dry-run",
    "mhc:next:spark": "node scripts/mhc-pipeline.mjs schedule-next",
    "mhc:window:dry-run": "node scripts/mhc-pipeline.mjs schedule-window --dry-run",
    "mhc:window:spark": "node scripts/mhc-pipeline.mjs schedule-window",
    "mhc:sync-latest": "node scripts/sync-latest-mhc.mjs",
    "mhc:review": "node scripts/review-mhc-schedule.mjs",
    "mhc:activate": "node scripts/mhc-pipeline.mjs activate",
    "mhc:ensure": "node scripts/mhc-pipeline.mjs ensure",
    "mhc:backfill:next": "node scripts/mhc-backfill-work-order.mjs",
    "bridge:extend": "node scripts/extend-celebration-bridge.mjs",
    "plan:long-term:generate": "node scripts/generate-long-term-schedule.mjs",
    "plan:long-term:check": "node scripts/generate-long-term-schedule.mjs --check",
    "study:next": "node scripts/rolling-study-work-order.mjs",
    "mhc:autonomy:nahum": "node scripts/mhc-pipeline.mjs generate --book NAM --chapter 1 --model gpt-5.3-codex-spark",
    "mhc:autonomy:1peter5": "node scripts/mhc-pipeline.mjs generate --book 1PE --chapter 5 --model gpt-5.3-codex-spark",
    "mhc:intro:luna": "node scripts/mhc-pipeline.mjs generate --book GEN --book-intro --model gpt-5.6-luna",
    "mhc:validate:luna": "node scripts/mhc-pipeline.mjs validate --book GEN --chapter 1 --model gpt-5.6-luna",
    "mhc:export:luna": "node scripts/mhc-pipeline.mjs export --book GEN --chapter 1 --model gpt-5.6-luna",
    "build:private-properties": "node scripts/build-private-script-properties.mjs",
    "safety": "node scripts/check-repository-safety.mjs --all",
    "validate": "node scripts/validate-content.mjs",
    "validate:sources": "node scripts/validate-source-registry.mjs",
    "validate:private": "node scripts/validate-private-content.mjs",
    "bundle:private": "node scripts/build-private-content-bundle.mjs",
    "test": "node --test tests/*.test.js",
    "check": "npm run safety && npm run validate && npm run validate:sources && npm run validate:private && npm test && npm run build && npm run verify:pages"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
