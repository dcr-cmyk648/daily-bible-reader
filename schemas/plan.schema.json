{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daily-bible-reader.local/schemas/plan.schema.json",
  "title": "Daily Bible Reader plan",
  "type": "object",
  "required": ["schemaVersion", "planVersion", "title", "canonId", "entries", "bookMetrics"],
  "properties": {
    "schemaVersion": {"const": "plan/v1"},
    "planVersion": {"type": "string", "minLength": 1, "maxLength": 80},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "canonId": {"type": "string", "minLength": 1, "maxLength": 100},
    "structure": {
      "type": "object",
      "required": ["oneReadingUnitPerDay", "bookIntroductionPolicy", "interweavingStrategy", "targetFinishTogether", "streams"],
      "properties": {
        "oneReadingUnitPerDay": {"const": true},
        "bookIntroductionPolicy": {"const": "immediately_before_chapter_1"},
        "interweavingStrategy": {"const": "proportional_four_stream"},
        "targetFinishTogether": {"const": true},
        "streams": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": ["streamId", "unitCount", "orderingRule"],
            "properties": {
              "streamId": {"enum": ["old_testament", "new_testament", "psalms", "proverbs"]},
              "unitCount": {"type": "integer", "minimum": 1},
              "orderingRule": {"type": "string", "minLength": 1, "maxLength": 1000}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "candidateMetadata": {
      "type": "object",
      "required": ["reviewOnly", "timezone", "startDate", "sundayPolicy", "inputSha256", "scheduleSha256", "nonSundayMinorExceptions"],
      "properties": {
        "reviewOnly": {"const": true},
        "timezone": {"type": "string", "minLength": 1, "maxLength": 100},
        "startDate": {"type": "string", "format": "date"},
        "sundayPolicy": {"enum": ["one_psalm_or_proverbs_unit", "proportional_psalm_days_with_proverbs_pairing"]},
        "inputSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "scheduleSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "scheduleModel": {"enum": ["psalm_proverbs_combined_v2"]},
        "ordinaryWisdomVerseTarget": {"type": "integer", "minimum": 1, "maximum": 500},
        "dailySlotCount": {"type": "integer", "minimum": 1},
        "streamContributionCounts": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 1}
        },
        "sundayOtherStreamExceptions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["dayIndex", "civilDate", "streamId", "reason"],
            "properties": {
              "dayIndex": {"type": "integer", "minimum": 1},
              "civilDate": {"type": "string", "format": "date"},
              "streamId": {"enum": ["old_testament", "new_testament"]},
              "reason": {"type": "string", "minLength": 1, "maxLength": 300}
            },
            "additionalProperties": false
          }
        },
        "nonSundayMinorExceptions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["dayIndex", "civilDate", "streamId", "reason"],
            "properties": {
              "dayIndex": {"type": "integer", "minimum": 1},
              "civilDate": {"type": "string", "format": "date"},
              "streamId": {"enum": ["psalms", "proverbs"]},
              "reason": {"type": "string", "minLength": 1, "maxLength": 300}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "reading.schema.json"}
    },
    "bookMetrics": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["verseCount", "chapterCount", "versification"],
        "properties": {
          "verseCount": {"type": "integer", "minimum": 1},
          "chapterCount": {"type": "integer", "minimum": 1},
          "versification": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
