{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daily-bible-reader.local/schemas/mhc-native-work-item.schema.json",
  "title": "Private native Matthew Henry scheduled work item",
  "type": "object",
  "required": ["schema_version", "work_item_id", "work_item_sha256", "lane", "plan_version", "reading_id", "schedule_date", "chapter", "chunk_id", "verse_ids", "source_hash", "normalized_hash", "prompt_version", "fact_prompt_version", "generation_mode", "required_model", "required_effort", "automation_id", "lease_id", "created_at", "source_view"],
  "properties": {
    "schema_version": {"const": "mhc-native-work-item/v1"},
    "work_item_id": {"type": "string", "pattern": "^MHNWI-[a-f0-9]{32}$"},
    "work_item_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "lane": {"const": "henry_backfill"},
    "plan_version": {"type": "string", "minLength": 1, "maxLength": 200},
    "reading_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,159}$"},
    "schedule_date": {"type": "string", "format": "date"},
    "chapter": {"type": "object", "required": ["book_id", "chapter", "verse_count"], "properties": {"book_id": {"type": "string", "pattern": "^[A-Z0-9]{2,8}$"}, "chapter": {"type": "integer", "minimum": 1}, "verse_count": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
    "chunk_id": {"type": "string", "pattern": "^[0-9]{3}-[0-9]{3}$"},
    "verse_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[A-Z0-9]{2,8}\\.[1-9][0-9]{0,2}\\.[1-9][0-9]{0,2}$"}},
    "source_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "normalized_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "prompt_version": {"const": "mhc-autonomous-writer/v5"},
    "fact_prompt_version": {"const": "mhc-fact-extractor/v8"},
    "generation_mode": {"const": "spark-autonomous-chunked-two-stage/v4"},
    "required_model": {"enum": ["gpt-5.3-codex-spark", "gpt-5.6-luna"]},
    "required_effort": {"enum": ["medium", "low"]},
    "automation_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "lease_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "source_view": {"type": "object"}
  },
  "additionalProperties": false
}
